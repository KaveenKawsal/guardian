# Copy to .env and adjust. All settings are optional.

# Where Guardian stores scan history and evidence (default: ~/.guardian)
# GUARDIAN_DATA_DIR=

# AI investigation (phase 5). Deterministic analysis works with AI disabled.
# Keys are read from ~/.guardian/.env and then ./.env (later wins), so putting them in
# ~/.guardian/.env makes them work from any directory. .env is git-ignored: never commit keys.
# Groq key:            https://console.groq.com/keys
# Google AI (Gemini):  https://aistudio.google.com/apikey  (GEMINI_API_KEY also works)
# Check with `guardian ai status`, `guardian ai models`, `guardian ai test`;
# switch with `guardian ai use groq|google [--model NAME]`.
GUARDIAN_AI_ENABLED=true
GROQ_API_KEY=
GOOGLE_API_KEY=
GUARDIAN_LLM_PROVIDER=groq
GUARDIAN_GROQ_MODEL=openai/gpt-oss-120b
GUARDIAN_GOOGLE_MODEL=gemini-3.5-flash
# GUARDIAN_LLM_MODEL=            # one-off override of the active provider's model
# GUARDIAN_LLM_TEMPERATURE=0
# GUARDIAN_LLM_TIMEOUT_SECONDS=60

# External tool limits
GUARDIAN_TOOL_TIMEOUT_SECONDS=300
GUARDIAN_MAX_TOOL_OUTPUT_BYTES=20971520
GUARDIAN_MAX_SBOM_BYTES=209715200

# Profiling limits
GUARDIAN_MAX_FILES=200000
GUARDIAN_MAX_MANIFEST_BYTES=5242880

# Security detection
# GUARDIAN_SEMGREP_CONFIGS=["p/default"]   # override the per-language rule packs
GUARDIAN_SEMGREP_RULE_TIMEOUT_SECONDS=30
GUARDIAN_CHANGE_HISTORY_COMMITS=50
GUARDIAN_MAX_BLAMED_FINDINGS=200
